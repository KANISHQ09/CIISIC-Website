generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  role                Role
  passwordHash        String?
  emailVerified       Boolean              @default(false)
  isActive            Boolean              @default(true)
  approvalStatus      String               @default("APPROVED")
  avatarUrl           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accounts            Account[]
  auditLogs           AuditLog[]
  reviewedChallenges  Challenge[]          @relation("ChallengeReviewer")
  industryProfile     IndustryProfile?     @relation("IndustryMainAccount")
  // Set for a colleague added to a company's team. The company's main account has industryProfile instead.
  teamIndustryProfileId String?
  teamIndustryProfile IndustryProfile?     @relation("IndustryTeam", fields: [teamIndustryProfileId], references: [id], onDelete: SetNull)
  institutionProfile  InstitutionProfile?
  sentMessages        Message[]            @relation("SentMessages")
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  submittedProposals  Proposal[]           @relation("ProposalSubmitter")

  @@index([email])
  @@index([role])
  @@index([teamIndustryProfileId])
}

model IndustryProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String
  industry    String
  logoUrl     String?
  websiteUrl  String?
  isCIIMember Boolean @default(false)

  // Contact details collected at registration
  phone       String?
  designation String?
  memberSince DateTime?
  createdAt   DateTime    @default(now())
  challenges  Challenge[]
  user        User        @relation("IndustryMainAccount", fields: [userId], references: [id], onDelete: Cascade)
  teamMembers User[]      @relation("IndustryTeam")
}

model Institution {
  id                 String              @id @default(cuid())
  name               String              @unique
  city               String
  state              String              @default("Madhya Pradesh")
  logoUrl            String?
  websiteUrl         String?
  cellTheme          CellTheme?
  spocUserId         String?
  createdAt          DateTime            @default(now())
  institutionProfile InstitutionProfile?
  proposals          Proposal[]
}

model InstitutionProfile {
  id            String @id @default(cuid())
  userId        String @unique
  institutionId String @unique
  designation   String
  department    String

  phone       String?
  createdAt   DateTime    @default(now())
  institution Institution @relation(fields: [institutionId], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Challenge {
  id                 String          @id @default(cuid())
  title              String
  description        String
  problemStatement   String
  domain             CellTheme
  status             ChallengeStatus @default(DRAFT)
  deadline           DateTime
  budgetRange        String?
  // Registered industry account this problem belongs to. Null when submitted publicly
  // by an organisation that is not registered on the portal ("Other").
  industryProfileId  String?
  // PORTAL = submitted by a logged-in industry user, PUBLIC = submitted without login
  submissionSource   String          @default("PORTAL")
  // Human-friendly ID given to the submitter, e.g. CII-2026-4F7K2Q
  referenceCode      String?         @unique
  // Organisation details typed by the submitter (always filled for "Other" submissions)
  isNewOrganisation  Boolean         @default(false)
  orgSector          String?
  orgWebsite         String?
  orgCity            String?
  orgState           String?
  orgAddress         String?
  // Person who submitted the problem (shown only to CII admins and the owning company)
  contactName        String?
  contactDesignation String?
  contactEmail       String?
  contactPhone       String?
  // Who may see contactPhone besides CII admins and the owning company
  phoneVisibility    PhoneVisibility @default(NO_ONE)
  // CII's standardised PDF of the industry's raw file, shown to viewers instead of the original
  standardisedFileUrl String?
  standardisedAt     DateTime?
  // When CII invited an unregistered organisation to create an industry account
  inviteSentAt       DateTime?
  attachmentUrls     String[]

  // Details from the submission form (all optional: older problems don't have them)
  existingProcess       String?
  expectedOutcome       String?
  projectObjectives     String?
  requiredSkills        String[]         @default([])
  preferredBranches     String[]         @default([])
  preferredAcademicYear String?
  // Easy | Medium | Hard
  difficultyLevel       String?
  expectedDeliverables  String?
  additionalNotes       String?
  tags                  String[]
  viewCount             Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  publishedAt           DateTime?
  organizationName      String?
  duration              String?
  reviewRemarks         String?
  reviewedAt            DateTime?
  reviewerId            String?
  industryProfile       IndustryProfile? @relation(fields: [industryProfileId], references: [id])
  reviewer              User?            @relation("ChallengeReviewer", fields: [reviewerId], references: [id])
  proposals             Proposal[]

  @@index([status])
  @@index([domain])
  @@index([deadline])
  @@index([contactEmail])
}

model Proposal {
  id               String         @id @default(cuid())
  challengeId      String
  // Institution that submitted the solution (one active solution per institution per challenge,
  // enforced in the API). Nullable only until legacy rows are backfilled.
  institutionId    String?
  // Institution SPOC account that submitted it
  submittedById    String?
  status           ProposalStatus @default(SUBMITTED)
  title            String?
  approachDoc      String?
  summary          String
  detailedApproach String?
  technologiesUsed String[]
  demoUrl          String?

  deliverables       String?
  // Team details entered by the institution: { name, email, department, yearOfStudy, phone? }
  teamName           String?
  teamLead           Json?
  // [{ name, email, role? }]
  teamMembers        Json?
  // { name, designation, email, phone? }
  facultyMentor      Json?
  revisionNotes      String?
  feedbackByIndustry String?
  submittedAt        DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  messages           Message[]
  challenge          Challenge    @relation(fields: [challengeId], references: [id])
  institution        Institution? @relation(fields: [institutionId], references: [id])
  submittedBy        User?        @relation("ProposalSubmitter", fields: [submittedById], references: [id])

  @@index([status])
  @@index([institutionId])
  @@index([challengeId, institutionId])
}

model Message {
  id            String      @id @default(cuid())
  proposalId    String
  senderId      String
  type          MessageType @default(QUERY)
  body          String
  attachmentUrl String?
  isSystemMsg   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  proposal      Proposal    @relation(fields: [proposalId], references: [id])
  sender        User        @relation("SentMessages", fields: [senderId], references: [id])

  @@index([proposalId])
  @@index([senderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

/// One row per counted request (public submissions, uploads, password-reset emails,
/// failed sign-ins). Kept in the database so limits survive restarts and work across
/// several server instances. Rows older than a day are cleaned up automatically.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

enum Role {
  SUPER_ADMIN
  CII_ADMIN
  INSTITUTION_SPOC
  INDUSTRY_SPOC
}

enum CellTheme {
  FAMILY_BUSINESS
  TALENT_READINESS
  RESEARCH_INNOVATION
  AI_IN_BUSINESS
  AGRITECH
  SKILL_DEVELOPMENT
  STARTUP
}

enum PhoneVisibility {
  EVERYONE
  INSTITUTION_SPOCS
  NO_ONE
}

enum ChallengeStatus {
  DRAFT
  OPEN
  UNDER_REVIEW
  CLOSED
  ARCHIVED
  PENDING_APPROVAL
  REJECTED
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
}

enum MessageType {
  QUERY
  RESPONSE
  SYSTEM_NOTICE
}
